handoff.md
.gstack/

# ralph loop runtime state (regenerated every loop)
.ralph/loop_state.json

# git worktrees created by parallel agents
.claude/worktrees/

# dependencies
/node_modules

# browser suite output — screenshots, the saved login, Playwright's results
/e2e/screenshots/
/e2e/.auth/
/test-results/
/playwright-report/

# next.js build output
/.next
/.next-dev
/out

# local environment — only .env.example and .env.ralph are committed
.env*
!.env.example
!.env.ralph

# editor backup files
*~

# typescript
*.tsbuildinfo
next-env.d.ts

# backtest run output stays local — only its README is committed
/scripts/backtest-runs/*
!/scripts/backtest-runs/README.md
