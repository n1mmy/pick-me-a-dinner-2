# Postgres connection string (plain — TLS terminates at the ingress).
DATABASE_URL=postgres://user:password@localhost:5432/pick_me_a_dinner

# Single shared password gating every route (ADR-0002).
APP_PASSWORD=change-me

# Secret used to seal the iron-session cookie — at least 32 characters.
APP_SECRET=replace-with-a-long-random-string-of-32-plus-chars

# IANA timezone for the household's local calendar day.
APP_TZ=America/Los_Angeles

# Optional — when unset, the Catalog hides the Google Places search box.
GOOGLE_PLACES_API_KEY=

# Optional — Anthropic API key for AI search on Tonight. When unset, AI search
# is simply absent; the deterministic ranking is unaffected.
ANTHROPIC_API_KEY=

# Optional — the Claude model AI search calls. Defaults to a current Opus.
AI_MODEL=

# Optional — how hard the model thinks before it ranks: off | low | medium |
# high. Defaults to low. Thinking is most of the call's latency, so this is the
# knob that trades speed for depth of reasoning over the Log. For a budget-API
# model (Sonnet, Haiku) a bare integer is also accepted as an explicit
# thinking-token budget; pairing one with an Opus model is rejected at startup,
# because Opus takes an effort level and has no token budget.
AI_EFFORT=

# Optional — the result shape for an empty or open query: full | pithy | drop.
# Defaults to pithy. A query that genuinely narrows the Catalog returns a
# focused shortlist in every mode; this only governs the open case. `full`
# ranks the whole Catalog with a full rationale on every row, `pithy` ranks the
# whole Catalog but shrinks the rationale as the pick gets weaker, and `drop`
# returns only a shortlist — which departs from ADR-0005 and is why it is not
# the default.
AI_TAIL_MODE=
