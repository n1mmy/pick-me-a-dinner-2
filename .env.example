# Postgres connection string (plain — TLS terminates at the ingress).
DATABASE_URL=postgres://user:password@localhost:5432/pick_me_a_dinner

# Single shared password gating every route (ADR-0002).
APP_PASSWORD=change-me

# Secret used to seal the iron-session cookie — at least 32 characters.
APP_SECRET=replace-with-a-long-random-string-of-32-plus-chars

# IANA timezone for the household's local calendar day.
APP_TZ=America/Los_Angeles

# Optional — when unset, the Catalog hides the Google Places search box.
GOOGLE_PLACES_API_KEY=

# Optional — Anthropic API key for AI search on Tonight. When unset, AI search
# is simply absent; the deterministic ranking is unaffected.
ANTHROPIC_API_KEY=

# Optional — the Claude model AI search calls. Defaults to a current Opus.
AI_MODEL=

# Optional — how hard the model thinks before it ranks: low | medium | high.
# Defaults to low, as does any other value. Thinking is most of the call's
# latency, so this is the knob that trades speed for depth of reasoning over
# the Log.
AI_EFFORT=

# Optional — the local model (Strata, any OpenAI-compatible server) that writes
# Prepared notes ahead of time (ADR-0011). Prepared notes are absent unless
# both LOCAL_AI_BASE_URL and LOCAL_AI_MODEL are set; the deterministic ranking
# and Claude AI search are unaffected either way. Calls are free, so unlike
# ANTHROPIC_API_KEY there is no cost to a call. The base URL is the server's
# `/v1` root, e.g. http://strata.local:8080/v1.
LOCAL_AI_BASE_URL=

# Optional — sent as a bearer token when set; leave empty for a server that
# takes no key. In production it comes from a k8s Secret, never the image.
LOCAL_AI_API_KEY=

# Optional — the model id the local server serves, e.g. qwen3.8-flash-next-iq3_s.
LOCAL_AI_MODEL=
